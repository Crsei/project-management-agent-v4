{
  "name": "project-management-agent-v4",
  "version": "0.1.1-preview.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "check:ci": "node scripts/check-ci.mjs",
    "check:affected": "node scripts/check-affected.mjs",
    "check:turbo": "node scripts/check-turbo.mjs",
    "check:boundaries": "node scripts/check-import-boundaries.mjs",
    "check:licenses": "node scripts/check-third-party-notices.mjs --integrity",
    "check:no-easyuse": "node scripts/check-no-easyuse.mjs",
    "check:release": "node scripts/check-third-party-notices.mjs --release",
    "dev:v4": "node scripts/services.mjs dev",
    "build:v4": "pnpm build && pnpm build:agent && pnpm build:web",
    "build:agent": "pnpm --filter @agent-workspace/contracts build && pnpm --filter @agent-workspace/client-runtime build && pnpm --filter @agent-workspace/server build",
    "dev:agent": "pnpm --filter @pm/web dev",
    "typecheck:agent": "pnpm --filter @agent-workspace/contracts typecheck && pnpm --filter @agent-workspace/client-runtime typecheck && pnpm --filter @agent-workspace/server typecheck",
    "test:agent": "pnpm --filter @agent-workspace/cc-switch-host test && node --test apps/server/gateway.test.ts && pnpm --filter @agent-workspace/client-runtime test && pnpm --filter @agent-workspace/server test && pnpm --filter @agent-workspace/desktop test",
    "lint:agent": "oxlint apps/server/agent apps/server/cc-switch-host apps/web/src/features/agent apps/desktop apps/marketing packages/agent-contracts packages/agent-client-runtime",
    "lint:gateway": "eslint apps/server/gateway.ts apps/server/gateway.test.ts --max-warnings=0",
    "lint:ci": "oxlint --deny-warnings scripts/check-ci.mjs scripts/check-ci-process.mjs scripts/check-ci-process.test.mjs scripts/check-sources.mjs scripts/check-affected.mjs scripts/check-affected.test.mjs scripts/check-task-graph.mjs scripts/check-turbo.mjs scripts/check-turbo.test.mjs",
    "lint:upstream": "oxlint --deny-warnings scripts/upstream-sync.mjs scripts/upstream-sync scripts/upstream-publish.mjs scripts/upstream-publish.test.mjs",
    "build:desktop": "pnpm --filter @agent-workspace/desktop build",
    "package:desktop": "pnpm --filter @agent-workspace/desktop package",
    "dev:marketing": "pnpm --filter @agent-workspace/marketing dev",
    "typecheck:marketing": "pnpm --filter @agent-workspace/marketing typecheck",
    "build:marketing": "pnpm --filter @agent-workspace/marketing build",
    "preview:marketing": "pnpm --filter @agent-workspace/marketing preview",
    "dev": "node --env-file-if-exists=.env --watch apps/server/pm/src/main.ts",
    "start": "node --env-file-if-exists=.env dist/apps/server/pm/src/main.js",
    "worker": "node --env-file-if-exists=.env.worker dist/apps/server/worker/src/main.js",
    "build": "tsc -p tsconfig.backend.json && node scripts/build-assets.mjs",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --test apps/server/pm/tests/*.test.ts packages/application/tests/*.test.ts packages/contracts/tests/*.test.ts packages/domain/tests/*.test.ts packages/infrastructure/tests/*.test.ts packages/pm-core/tests/*.test.ts packages/pm-markdown/tests/*.test.ts packages/pm-cli/tests/*.test.ts",
    "test:integration": "node --env-file=.env scripts/backend-tests.mjs integration",
    "check:docs": "node scripts/check-docs.mjs",
    "check": "pnpm check:docs && pnpm check:boundaries && pnpm check:licenses && pnpm check:no-easyuse && pnpm contracts:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "setup:local": "node scripts/setup-local.mjs",
    "db:up": "docker compose --env-file .env -f deploy/compose.yaml up -d --wait postgres",
    "db:migrate": "node --env-file=.env scripts/migrate.ts",
    "bootstrap": "node --env-file=.env scripts/bootstrap.ts",
    "contracts:generate": "node scripts/generate-contracts.ts",
    "services:start": "node scripts/services.mjs start",
    "services:status": "node scripts/services.mjs status",
    "services:stop": "node scripts/services.mjs stop",
    "contracts:check": "node scripts/generate-contracts.ts --check",
    "smoke": "node --env-file=.env scripts/smoke.ts",
    "smoke:verify": "node --env-file=.env scripts/smoke.ts --verify",
    "backup": "node --env-file=.env scripts/backup.mjs",
    "backup:verify": "node --env-file=.env scripts/backup.mjs --verify",
    "agent:backup": "node --conditions=development scripts/agent-backup.ts",
    "agent:backup:verify": "node --conditions=development scripts/agent-backup.ts verify",
    "integrations:migrate": "node scripts/migrate-automation-integrations.ts",
    "outbox:failed": "node --env-file=.env scripts/outbox-admin.ts failed",
    "outbox:retry": "node --env-file=.env scripts/outbox-admin.ts retry",
    "notifications:status": "node --env-file=.env.worker scripts/notification-admin.ts status",
    "notifications:retry": "node --env-file=.env.worker scripts/notification-admin.ts retry",
    "storage": "node --env-file-if-exists=.env scripts/blob-storage.ts",
    "storage:projects": "node --env-file-if-exists=.env scripts/local-project-storage.ts",
    "test:db": "node --env-file=.env scripts/backend-tests.mjs db",
    "lint": "eslint apps/server/pm/src apps/server/worker/src packages/application/src packages/domain/src packages/infrastructure/src packages/contracts/src packages/automation-resources packages/pm-cli scripts/*.ts tests/*.ts",
    "account:create": "node --env-file=.env scripts/create-account.ts",
    "dev:web": "pnpm --filter @pm/web dev",
    "build:web": "pnpm --filter @pm/web build",
    "preview:web": "pnpm --filter @pm/web preview",
    "check:web": "pnpm --filter @pm/web lint && pnpm --filter @pm/web build",
    "storybook": "pnpm --filter @pm/web storybook",
    "test:backend": "node --env-file=.env scripts/backend-tests.mjs backend",
    "pm": "node --env-file-if-exists=.env packages/pm-cli/index.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.10",
    "eslint": "10.12.0",
    "github-slugger": "2.0.0",
    "mdast-util-to-string": "4.0.0",
    "oxlint": "^1.87.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1155.0",
    "@fastify/cookie": "11.1.3",
    "@jmespath-community/jmespath": "1.3.0",
    "chokidar": "^4.0.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "micromark-util-decode-string": "^2.0.1",
    "nodemailer": "^10.1.7",
    "pg": "8.23.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
