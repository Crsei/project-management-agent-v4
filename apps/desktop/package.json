{
  "name": "@agent-workspace/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Secure Electron host for the PM Agent v4 unified Web and local services",
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "runtime:install": "node scripts/ensure-electron.mjs",
    "start": "node scripts/launch.mjs",
    "dev": "pnpm run build && pnpm run start",
    "runtime:prepare": "node scripts/prepare-runtime.mjs",
    "runtime:smoke": "node scripts/smoke-runtime.mjs",
    "stage:workspace": "node scripts/stage-workspace.mjs",
    "smoke:managed": "node scripts/smoke-managed.mjs",
    "package": "node scripts/package.mjs --unsigned",
    "package:signed": "node scripts/package.mjs --signed",
    "test": "node scripts/test.mjs",
    "test:contracts": "node scripts/test.mjs contracts",
    "test:lifecycle": "node scripts/test.mjs lifecycle",
    "test:integration": "node scripts/test.mjs integration"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "extract-zip": "2.0.1",
    "tar": "7.5.17"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
