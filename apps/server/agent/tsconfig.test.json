{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["../../web/src/*"]
    },
    "customConditions": ["development"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
