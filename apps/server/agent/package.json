{
  "name": "@agent-workspace/server",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "node --conditions=development --watch --import ./scripts/dev-environment.mjs src/index.ts",
    "build": "pnpm run typecheck && node scripts/build.mjs",
    "start": "node dist/index.mjs",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json --noEmit",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@agent-workspace/client-runtime": "workspace:*",
    "@agent-workspace/contracts": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "0.3.276",
    "@assistant-ui/ai-sdk": "^0.0.12",
    "@cursor/sdk": "1.0.38",
    "@hono/node-server": "^1.19.1",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@muse-code/sdk": "1.4.6",
    "@napi-rs/keyring": "1.3.0",
    "@effect/platform-node": "4.0.5",
    "@pm/t3code-provider-server": "workspace:*",
    "@t3tools/contracts": "workspace:*",
    "@t3tools/shared": "workspace:*",
    "@t3tools/provider-core": "workspace:*",
    "@t3tools/provider-opencode": "workspace:*",
    "@t3tools/provider-cursor": "workspace:*",
    "@t3tools/provider-grok": "workspace:*",
    "@t3tools/provider-fx": "workspace:*",
    "@t3tools/provider-muse": "workspace:*",
    "@t3tools/provider-pi": "workspace:*",
    "@t3tools/provider-acp": "workspace:*",
    "@t3tools/provider-acp-registry": "workspace:*",
    "effect": "4.0.5",
    "effect-acp": "workspace:*",
    "effect-codex-app-server": "workspace:*",
    "ai": "^7.0.130",
    "hono": "^4.9.7",
    "jose": "6.2.2",
    "tar": "^7.5.7",
    "ws": "^8.22.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "@types/yauzl": "^3.4.0",
    "esbuild": "^0.25.10",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  }
