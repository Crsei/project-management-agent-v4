# Public, build-time values. Rebuild the static site after changing them.
# No access tokens, provider credentials, or other secrets belong here.
#
# Unified v4 app entry. Use http://127.0.0.1:3224/pm for a local checkout.
PUBLIC_APP_URL=http://127.0.0.1:3224/pm

# Optional absolute HTTPS release page, without credentials.
# A configured page is not proof of a verified installer. Leave empty until release.
PUBLIC_DESKTOP_RELEASE_URL=

# Published repository; the homepage is not proof of corresponding artifact source.
PUBLIC_SOURCE_URL=https://github.com/Crsei/project-management-agent-v4
