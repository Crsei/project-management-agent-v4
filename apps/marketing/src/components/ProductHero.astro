---
import ProductImage from "./ProductImage.astro";
---

<section class="product-hero" aria-labelledby="hero-title" data-product-hero>
  <div class="container">
    <div class="product-hero-copy">
      <p class="eyebrow">PROJECTS. CONTEXT. AGENT CHAT.</p>
      <h1 id="hero-title">从项目任务，<br />到可核对的 Agent 交付。</h1>
      <p class="product-hero-description">Dovspace 将项目任务、Markdown 文档与 Agent Chat 衔接起来，<br class="product-hero-break" />让执行目标更明确，让工作结果有据可查。</p>
      <div class="open-actions product-hero-actions">
        <a class="btn btn-primary btn-lg" href="/get-started/">开始使用 <span aria-hidden="true">↗</span></a>
        <a class="btn btn-ghost btn-lg" href="#product">查看产品界面 <span aria-hidden="true">↓</span></a>
      </div>
      <p class="small-note product-hero-boundary">可信本机自托管 · 单 Agent 操作者 <span aria-hidden="true">/</span> <a href="/security/">了解安全边界</a></p>
    </div>
    <div class="product-hero-preview" data-hero-preview>
      <ProductImage family="project-board" eager id="hero-project-board" />
    </div>
  </div>
</section>

<style>
  .product-hero {
    padding-block: 48px 64px;
    background: var(--bg);
  }

  .product-hero-copy {
    margin-inline: auto;
    text-align: center;
  }

  .product-hero h1 {
    margin: 14px auto 18px;
    color: var(--fg);
    font-size: clamp(42px, 4.2vw, 60px);
    font-weight: 600;
    letter-spacing: -.045em;
    line-height: 1.2;
  }

  .product-hero-description {
    max-width: 800px;
    margin-inline: auto;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.8;
    text-wrap: pretty;
  }

  .product-hero-actions {
    justify-content: center;
    gap: 12px;
    margin-top: 24px;
  }

  .product-hero-boundary {
    margin-top: 14px;
  }

  .product-hero-boundary > span {
    margin-inline: 8px;
    color: var(--strong);
  }

  .product-hero-boundary a {
    display: inline-block;
    padding-block: 4px;
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .product-hero-boundary a:hover {
    color: var(--accent);
  }

  .product-hero-preview {
    margin-top: 32px;
    min-width: 0;
  }

  @media (max-width: 820px) {
    .product-hero {
      padding-block: 40px 48px;
    }

    .product-hero h1 {
      font-size: clamp(34px, 5.6vw, 46px);
    }

    .product-hero-description {
      max-width: 620px;
      font-size: 16px;
    }

    .product-hero-break {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .product-hero {
      padding-top: 32px;
    }

    .product-hero h1 {
      font-size: clamp(30px, 8.2vw, 38px);
      letter-spacing: -.045em;
      line-height: 1.28;
    }

    .product-hero-actions {
      align-items: stretch;
    }

    .product-hero-actions .btn {
      flex: 1 1 auto;
      padding-inline: 14px;
    }

    .product-hero-boundary {
      max-width: 310px;
      margin-inline: auto;
    }

    .product-hero-preview {
      margin-top: 24px;
    }
  }
</style>
