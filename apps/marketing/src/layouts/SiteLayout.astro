---
import '../styles/global.css';
import { appLabel, appNote, appUrl, sourceUrl } from '../lib/site';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const navigation = [
  { href: '/', label: '产品' },
  { href: '/get-started/', label: '自托管' },
  { href: '/desktop/', label: '桌面' },
  { href: '/download/', label: '下载状态' },
  { href: '/security/', label: '安全与运维' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafaf9" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} — Dovspace`} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} — Dovspace</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="wordmark" href="/" aria-label="Dovspace 首页">
          <svg viewBox="0 0 24 24" width="25" height="25" fill="none" aria-hidden="true">
            <path d="M2 2h8v8H2zm12 0h8v8h-8zM2 14h8v8H2z" fill="currentColor" />
            <path d="M14 14h8v8h-8z" fill="var(--accent)" />
          </svg>
          <span>Dovspace</span>
        </a>
        <nav class="primary-navigation" aria-label="主要导航">
          {navigation.map(({ href, label }) => (
            <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
        <a class="button button-small button-outline header-entry" href={appUrl}>
          {appLabel}<span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <div class="footer-top">
          <div>
            <a class="footer-name" href="/">Dovspace</a>
            <p>可信本机、单操作者的项目与 Agent 工作台。</p>
          </div>
          <nav aria-label="页脚导航">
            <a href="/get-started/">自托管入门</a>
            <a href="/desktop/">桌面说明</a>
            <a href="/security/">安全与限制</a>
            {sourceUrl && <a href={sourceUrl}>源码仓库 ↗</a>}
            <a href="/THIRD_PARTY_NOTICES.txt">第三方说明</a>
          </nav>
        </div>
        <div class="footer-bottom">
          <p>PM 账号与 Agent 操作者身份独立，不提供公网多租户隔离。</p>
          <p>{appNote}</p>
        </div>
      </div>
    </footer>
  </body>
</html>
