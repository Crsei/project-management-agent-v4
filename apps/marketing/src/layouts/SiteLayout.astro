---
import "../styles/site.css";
import { appLabel, appNote, appUrl, sourceUrl } from "../lib/site";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const pageTitle = title.includes("Dovspace") ? title : `${title} — Dovspace`;
const currentPath = `${Astro.url.pathname.replace(/\/+$/, "")}/`;
const navigation = [
  { href: "/", label: "产品" },
  { href: "/get-started/", label: "部署方式" },
  { href: "/plans/", label: "套餐与用量" },
];
const resources = [
  { href: "/desktop/", label: "桌面使用", description: "本地模式与运行边界" },
  { href: "/download/", label: "发行与下载状态", description: "查看版本和验证进展" },
  { href: "/security/", label: "安全与运维", description: "身份、执行与数据边界" },
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dovspace" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.svg?v=20261115" type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body class="marketing">
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <header class="nav" data-site-header>
      <div class="container nav-inner">
        <a href="/" class="brand" aria-label="Dovspace 首页"><img class="brand-mark" src="/dovspace.svg?v=20261115" width="32" height="32" alt="" /><span>Dovspace</span></a>
        <div class="nav-panel" id="primary-navigation">
          <nav class="nav-links" aria-label="主要导航">
            {navigation.map(({ href, label }) => (
              <a href={href} aria-current={currentPath === href ? "page" : undefined}>{label}</a>
            ))}
            <details class="nav-resources" data-current={resources.some(({ href }) => href === currentPath) ? "true" : undefined}>
              <summary>文档与资源</summary>
              <div class="nav-resource-list">
                {resources.map(({ href, label, description: detail }) => (
                  <a href={href} aria-current={currentPath === href ? "page" : undefined}><strong>{label}</strong><span>{detail}</span></a>
                ))}
              </div>
            </details>
          </nav>
          <a class="nav-workspace" href={appUrl}>{appLabel} <span aria-hidden="true">↗</span></a>
        </div>
        <a class="btn btn-primary nav-cta" href="/get-started/">开始使用 <span aria-hidden="true">↗</span></a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" hidden>菜单 <span aria-hidden="true">≡</span></button>
      </div>
    </header>
    <main id="main-content" tabindex="-1"><slot /></main>
    <footer class="footer">
      <div class="container footer-inner">
        <div class="footer-intro">
          <a class="footer-brand" href="/" aria-label="Dovspace 首页"><img class="brand-mark" src="/dovspace.svg?v=20261115" width="32" height="32" alt="" />Dovspace</a>
          <p class="footer-tagline">项目有上下文，<br />交付有据可查。</p>
        </div>
        <nav class="footer-group" aria-label="产品导航">
          <h2>产品</h2>
          <a href="/#product">查看产品界面</a>
          <a href="/#workflow">工作流程</a>
          <a href="/plans/">套餐与用量规划</a>
        </nav>
        <nav class="footer-group" aria-label="部署导航">
          <h2>部署与使用</h2>
          <a href="/get-started/">开始自托管</a>
          <a href="/desktop/">桌面使用说明</a>
          <a href="/download/">发行与下载状态</a>
        </nav>
        <nav class="footer-group" aria-label="资源导航">
          <h2>资源与边界</h2>
          <a href="/security/">安全与运维</a>
          <a href="/legal.html">许可与对应源码</a>
          <a href="/LICENSE">AGPL-3.0-only</a>
          <a href="/THIRD_PARTY_NOTICES.txt">第三方说明</a>
          {sourceUrl && <a href={sourceUrl}>源码仓库 <span aria-hidden="true">↗</span></a>}
        </nav>
      </div>
      <div class="container footer-notes">
        <p>面向可信本机、单操作者。PM 账号与 Agent 身份独立；文件目录不是沙箱。</p>
        <p>已有运行实例？<a href={appUrl}>{appLabel} <span aria-hidden="true">↗</span></a> · {appNote}</p>
      </div>
    </footer>
    <script>
      const header = document.querySelector<HTMLElement>("[data-site-header]");
      const panel = document.querySelector<HTMLElement>("#primary-navigation");
      const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
      const resources = document.querySelector<HTMLDetailsElement>(".nav-resources");
      if (header && panel && toggle) {
        const mobile = window.matchMedia("(max-width: 900px)");
        const updateMenu = () => {
          toggle.hidden = !mobile.matches;
          panel.hidden = mobile.matches && toggle.getAttribute("aria-expanded") !== "true";
        };
        const closeMenu = (restoreFocus = false) => {
          toggle.setAttribute("aria-expanded", "false");
          updateMenu();
          if (restoreFocus && mobile.matches) toggle.focus();
        };
        toggle.addEventListener("click", () => {
          toggle.setAttribute("aria-expanded", String(toggle.getAttribute("aria-expanded") !== "true"));
          updateMenu();
        });
        header.addEventListener("keydown", (event) => {
          if (event.key !== "Escape") return;
          if (resources?.open) {
            resources.open = false;
            resources.querySelector("summary")?.focus();
          } else {
            closeMenu(true);
          }
        });
        document.addEventListener("click", (event) => {
          if (!(event.target instanceof Node)) return;
          if (resources?.open && !resources.contains(event.target)) resources.open = false;
          if (!header.contains(event.target)) closeMenu();
        });
        mobile.addEventListener("change", updateMenu);
        updateMenu();
      }
    </script>
  </body>
</html>
