---
import SiteLayout from './SiteLayout.astro';
import '../styles/guide.css';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  contents: { id: string; label: string }[];
}

const { title, description, eyebrow, contents } = Astro.props;
const currentPath = `${Astro.url.pathname.replace(/\/+$/, '')}/`;
---

<SiteLayout title={title} description={description}>
  <header class="page-heading container">
    <p class="eyebrow">{eyebrow}</p>
    <h1 id="guide-title">{title}</h1>
    <p class="page-lead">{description}</p>
  </header>
  <div class="guide-layout container">
    <aside class="guide-sidebar">
      <nav class="guide-contents" aria-label="本页目录">
        <p class="eyebrow">本页目录</p>
        <ol>
          {contents.map(({ id, label }) => <li><a href={`#${id}`}>{label}</a></li>)}
        </ol>
      </nav>
      <nav class="guide-related" aria-label="相关指南">
        <a class="text-link" href="/get-started/" aria-current={currentPath === '/get-started/' ? 'page' : undefined}>自托管入门</a>
        <a class="text-link" href="/plans/" aria-current={currentPath === '/plans/' ? 'page' : undefined}>套餐与用量规划</a>
        <a class="text-link" href="/security/" aria-current={currentPath === '/security/' ? 'page' : undefined}>安全与限制</a>
      </nav>
    </aside>
    <article class="prose" aria-labelledby="guide-title">
      <slot />
    </article>
  </div>
</SiteLayout>
