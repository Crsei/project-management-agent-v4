{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "ES2024.Promise", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "incremental": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@agent/*": ["./src/features/agent/*"],
      "@/*": ["./src/*"],
      "@contracts": ["../../packages/contracts/src/client.ts"],
      "@pm-schema": ["../../packages/pm-schema/index.ts"],
      "@pm-schema/*": ["../../packages/pm-schema/*"],
      "@pm-markdown": ["../../packages/pm-markdown/index.ts"],
      "@pm-core": ["../../packages/pm-core/index.ts"],
      "@pm-core/*": ["../../packages/pm-core/*"],
      "@pm-views": ["../../packages/pm-views/index.tsx"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
