{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "ES2024.Promise", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "incremental": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@agent/*": ["./src/features/agent/*"],
      "@pm/openhands-extensions": ["../../vendor/openhands-extensions/src/web/index.tsx"],
      "@pm/openhands-source/*": ["../../vendor/openhands-extensions/src/*"],
      "@pm/cc-switch-source/*": ["../../vendor/cc-switch/src/*"],
      "@openhands/extensions/integrations": ["../../vendor/openhands-extensions/extensions/integrations/index.d.ts"],
      "@/*": ["./src/*"],
      "@contracts": ["../../packages/contracts/src/client.ts"],
      "@pm-schema": ["../../packages/pm-schema/index.ts"],
      "@pm-schema/*": ["../../packages/pm-schema/*"],
      "@pm-markdown": ["../../packages/pm-markdown/index.ts"],
      "@pm-core": ["../../packages/pm-core/index.ts"],
      "@pm-core/*": ["../../packages/pm-core/*"],
      "@pm-views": ["../../packages/pm-views/index.tsx"],
      "@pm/ui": ["../../packages/ui/src/index.ts"],
      "@pm/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
