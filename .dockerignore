# Build-context allowlist. Secrets, local data and generated output never enter the context.
**
!.dockerignore
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json
!tsconfig.backend.json
!scripts/
!scripts/build-assets.mjs
!scripts/blob-storage.ts
!scripts/notification-admin.ts
!apps/
!apps/api/
!apps/api/package.json
!apps/api/src/
!apps/api/src/**
!apps/worker/
!apps/worker/src/
!apps/worker/src/**
!apps/web/
!apps/web/package.json
!apps/web/index.html
!apps/web/tsconfig.json
!apps/web/vite.config.ts
!apps/web/src/
!apps/web/src/**
!apps/web/public/
!apps/web/public/**
!packages/
!packages/**
!deploy/
!deploy/Dockerfile
!deploy/Caddyfile
!deploy/manage.mjs
# Reapply exclusions after recursively allowing package source directories.
**/node_modules
**/tests
**/dist
**/.local
**/.env*
**/*.tsbuildinfo
