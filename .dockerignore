# Build-context allowlist. Secrets, local data and generated output never enter the context.
**
!.dockerignore
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json
!tsconfig.backend.json
!tsconfig.agent.json
!scripts/
!scripts/build-assets.mjs
!scripts/blob-storage.ts
!scripts/notification-admin.ts
!scripts/local-project-storage.ts
!apps/
!apps/server/
!apps/server/**
!apps/web/
!apps/web/**
!apps/desktop/
!apps/desktop/package.json
!tools/
!tools/marketing/
!tools/marketing/package.json
!patches/
!patches/**
!vendor/
!vendor/**
!packages/
!packages/**
!deploy/
!deploy/Dockerfile
!deploy/Caddyfile
!deploy/manage.mjs
# Reapply exclusions after recursively allowing package source directories.
**/node_modules
**/tests
**/dist
**/.local
**/.env*
**/*.tsbuildinfo
**/release
**/.astro
