# Build-context allowlist. Secrets, local data and generated output never enter the context.
**
!.dockerignore
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!.node-version
!rust-toolchain.toml
!LICENSE
!LICENSE.t3code
!THIRD_PARTY_NOTICES.md
!tsconfig.base.json
!tsconfig.backend.json
!tsconfig.agent.json
!tsconfig.check.json
!scripts/
!scripts/**
!scripts/build-assets.mjs
!scripts/blob-storage.ts
!scripts/notification-admin.ts
!scripts/local-project-storage.ts
!apps/
!apps/server/
!apps/server/**
!apps/web/
!apps/web/**
!apps/desktop/
!apps/desktop/**
!apps/marketing/
!apps/marketing/package.json
!patches/
!patches/**
!vendor/
!vendor/**
!packages/
!packages/**
!deploy/
!deploy/Dockerfile
!deploy/Caddyfile
!deploy/manage.mjs
!docs/
!docs/**
docs/agent-source/
docs/frontend-design-adoption.md
docs/implementation/
docs/reference/
# Exact first-party runtime Skill sources and plugin generation inputs.
!.agents/
!.agents/skills/
!.agents/skills/pm-requirement-review/
!.agents/skills/pm-requirement-review/SKILL.md
!.agents/skills/pm-plan-draft/
!.agents/skills/pm-plan-draft/SKILL.md
!.agents/skills/pm-evidence-review/
!.agents/skills/pm-evidence-review/SKILL.md
!.agents/skills/pm-project-digest/
!.agents/skills/pm-project-digest/SKILL.md
!.agents/skills/pm-collaboration-review/
!.agents/skills/pm-collaboration-review/SKILL.md
!.agents/skills/pm-automation-candidate-review/
!.agents/skills/pm-automation-candidate-review/SKILL.md
!plugins/
!plugins/dovspace-pm/
!plugins/dovspace-pm/plugin.json
!plugins/dovspace-pm/LICENSE
!plugins/dovspace-pm/README.md
!plugins/dovspace-pm/skills/
!plugins/dovspace-pm/skills/project-management/
!plugins/dovspace-pm/skills/project-management/SKILL.md
!plugins/dovspace-pm/skills/issue-management/
!plugins/dovspace-pm/skills/issue-management/SKILL.md
!plugins/dovspace-pm/skills/task-planning/
!plugins/dovspace-pm/skills/task-planning/SKILL.md
# Reapply exclusions after recursively allowing package source directories.
**/node_modules
**/tests
**/dist
**/.local
**/.env*
**/*.tsbuildinfo
**/release
**/.astro
# cc-switch originals are provenance inputs, including fixtures; they are never
# copied from this builder context into the final native runtime image.
!vendor/cc-switch/tests/
!vendor/cc-switch/tests/**
!vendor/cc-switch/src-tauri/tests/
!vendor/cc-switch/src-tauri/tests/**
!vendor/cc-switch/**/tests/
!vendor/cc-switch/**/tests/**
**/target
**/.cache
**/.runtime
**/releases
**/node_modules
**/.env*
