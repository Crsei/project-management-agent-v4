# `pnpm setup:local` creates private .env and .env.worker files without printing credentials.
# Keep Worker configuration separate; never copy AWS_, S3_, SOURCE_S3_ or TARGET_S3_ identity into it.
HOST=127.0.0.1
PORT=4194
PUBLIC_ORIGIN=http://127.0.0.1:3224
PM_API_URL=http://127.0.0.1:4194
PM_WEB_PORT=3224
POSTGRES_PORT=55444
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_PASSWORD=replace-with-a-new-v4-private-random-password
DATABASE_URL=postgresql://project_management:replace-with-a-new-v4-private-random-password@127.0.0.1:55444/project_management
# Storage requires an explicit stopped bind/adopt operation before readiness.
BLOB_PROVIDER=local
BLOB_ROOT=.local/blobs
# Shared workspace configuration, identity ledger and legacy Markdown; mapped projects live in their selected roots.
CORE_WORKSPACE_ROOT=.local/pm-workspaces
# Chat Space defaults to the API user's ~/.pmv4; this does not move existing Agent/native project paths.
# The parent must already exist; only the root leaf and authorized scope folders may be created.
# PM_CHAT_SPACE_ROOT=/absolute/user-home/.pmv4
# Trusted host-side local-project configuration; setup:local creates this without replacing an existing file.
# LOCAL_PROJECT_CONFIG=.local/local-projects.json
# Environment values override that configuration. Approved directories must already exist.
# LOCAL_PROJECTS_ENABLED=true
# LOCAL_PROJECT_ALLOWED_ROOTS=["/absolute/approved-projects"]
# LOCAL_PROJECT_DEFAULT_PARENT=/absolute/approved-projects
# LOCAL_DATA_ROOT=.local
# LOCAL_BACKUP_ROOT=.local/backups
# LOCAL_DATA_ROOT changes default core/backup roots, not explicit CORE_WORKSPACE_ROOT, legacy BLOB_ROOT or PostgreSQL volumes.
# Set true when the host inotify watch limit is exhausted; falls back to polling.
CHOKIDAR_USEPOLLING=false
COOKIE_SECURE=false
WORKER_INTERVAL_MS=500
EVENT_RETENTION_DAYS=7
