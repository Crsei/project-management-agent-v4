# setup:local creates a private .env.agent; do not copy another installation's secrets.
HOST=127.0.0.1
AGENT_WORKSPACE_API_PORT=4323
AGENT_WEB_PORT=4324
PM_API_URL=http://127.0.0.1:4193
AGENT_WORKSPACE_API_ONLY=1
# Resolved against this repository, never ~/.agent-workspace.
AGENT_WORKSPACE_DATA_DIR=.local/agent-data
VITE_ENABLE_UI_LAB=0
# Provider configuration is available at /agent/settings/providers.
# Codex and Claude are enabled initially; the other t3code native Agents are opt-in.
# Authentication belongs to each native Agent and its explicitly configured v3-owned home.
# No standalone model-API Provider, global CLI home or credential is imported implicitly.
# Non-loopback binding still requires a private 32+ character access token.
# AGENT_WORKSPACE_ACCESS_TOKEN=
# Explicit GitHub integration only; never copy old tokens.
# GITHUB_TOKEN=
# Legacy inspector root only; scoped chat cwd is resolved by the PM API per request.
# AGENT_WORKSPACE_PROJECT_ROOT=.local/projects
# Standalone static host uses apps/agent-web/dist; API-only service needs no Web build.
# AGENT_WORKSPACE_WEB_DIST=apps/agent-web/dist
