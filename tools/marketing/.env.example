# Public, build-time values. Rebuild the static site after changing them.
# No access tokens, provider credentials, or other secrets belong here.
PUBLIC_WORKSPACE_URL=http://127.0.0.1:3223/agent/workspace

# Optional absolute HTTPS release page or artifact URL, without embedded credentials.
# Leave empty until you publish a real desktop release. Otherwise the site shows build instructions.
PUBLIC_DESKTOP_RELEASE_URL=
