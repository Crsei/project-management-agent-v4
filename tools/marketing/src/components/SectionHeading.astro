---
interface Props {
  kicker: string;
  title: string;
  description: string;
  id?: string;
}

const { kicker, title, description, id } = Astro.props;
---

<header class="section-heading" id={id}>
  <p class="eyebrow"><span class="eyebrow-rule" aria-hidden="true"></span>{kicker}</p>
  <h2>{title}</h2>
  <p class="section-lead">{description}</p>
</header>
