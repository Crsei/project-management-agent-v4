---
import SiteLayout from './SiteLayout.astro';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  contents: { id: string; label: string }[];
}

const { title, description, eyebrow, contents } = Astro.props;
---

<SiteLayout title={title} description={description}>
  <section class="page-heading container">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="page-lead">{description}</p>
  </section>
  <div class="guide-layout container">
    <aside class="guide-sidebar">
      <nav aria-label="On this page">
        <p class="eyebrow">On this page</p>
        <ol>
          {contents.map(({ id, label }) => <li><a href={`#${id}`}>{label}</a></li>)}
        </ol>
      </nav>
      <a class="text-link" href="/get-started/">Self-host guide <span aria-hidden="true">↗</span></a>
      <a class="text-link" href="/security/">Security &amp; limits <span aria-hidden="true">↗</span></a>
    </aside>
    <article class="prose">
      <slot />
    </article>
  </div>
</SiteLayout>
