---
import V4Layout from "../layouts/V4Layout.astro";
import CapabilityCard from "../components/CapabilityCard.astro";
import PlaceholderCard from "../components/PlaceholderCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import {
  boundaries,
  capabilities,
  evidenceItems,
  placeholders,
  platformItems,
  verificationNumbers,
} from "../lib/capabilities";
import { agentWorkspaceUrl, appLabel, appNote, appUrl } from "../lib/site";
---

<V4Layout>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-rule" aria-hidden="true"></span>Self-hosted / Single-user / v4</p>
        <h1>
          项目、任务与编码 Agent，<br />
          <span class="accent">同一个工作台。</span>
        </h1>
        <p class="hero-lead">
          PM 保留项目、任务、文档与业务边界；Agent Chat 提供会话、Provider 与真实执行。
          两者共用一套 Web、桌面和同源服务端，不再维护第二个 PM 模型助手。
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href={appUrl}>{appLabel}<span aria-hidden="true">↗</span></a>
          <a class="button button-ghost" href="#capabilities">查看已实现能力<span aria-hidden="true">↓</span></a>
        </div>
        <p class="entry-note">{appNote}</p>
      </div>

      <figure class="hero-board">
        <div class="board-bar">
          <span class="board-lights" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="board-title">unified workspace / architecture</span>
          <span class="board-badge">self-hosted</span>
        </div>
        <div class="board-body">
          <div class="board-layer">
            <span class="layer-label">Browser / Desktop · 同一套 Web 产物</span>
            <div class="board-panels">
              <div class="board-panel">
                <span class="panel-kicker">PM</span>
                <strong>项目 / 任务 / 文档</strong>
                <div class="panel-chips">
                  <span>项目</span><span>任务</span><span>里程碑</span><span>评论</span><span>审核</span>
                </div>
                <div class="panel-lines" aria-hidden="true"><span></span><span></span><span></span></div>
              </div>
              <div class="board-panel agent">
                <span class="panel-kicker">AGENT</span>
                <strong>Session / Composer</strong>
                <div class="panel-chips">
                  <span>Files</span><span>Git</span><span>Terminal</span><span>Browser</span>
                </div>
                <div class="panel-lines" aria-hidden="true"><span></span><span></span><span></span></div>
              </div>
            </div>
          </div>
          <div class="board-connector">同源网关 / 同一套会话与执行</div>
          <div class="board-layer board-layer-server">
            <span class="layer-label">Your server · 本机服务组</span>
            <div class="server-row">
              <span>PM API</span><span>Agent API</span><span>Worker</span><span>Gateway</span>
            </div>
            <div class="server-row muted">
              <span>PostgreSQL</span><span>SQLite</span><span>.pm/core</span><span>Blob store</span>
            </div>
          </div>
        </div>
        <figcaption>架构示意，非产品截图。真实界面截图位置见「待补充」。</figcaption>
      </figure>
    </div>
  </section>

  <section id="capabilities" class="section">
    <div class="container">
      <SectionHeading
        kicker="Implemented / 已实现"
        title="只列出仓库里能指到实现的能力。"
        description="下面每一项都对应现有路由、包或 README 中的交付记录。没有产品截图、客户评价、价格或公开指标，就不在页面上编造。"
      />

      <div class="cap-grid">
        {capabilities.map((capability) => <CapabilityCard {capability} />)}
      </div>

      <div class="platform-strip">
        {platformItems.map((item) => (
          <div class="platform-item">
            <h3>{item.title}</h3>
            <p>{item.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="evidence" class="section">
    <div class="container">
      <SectionHeading
        kicker="Evidence / 跑通记录"
        title="有记录，但只写到记录为止。"
        description="以下来自 README 的本机或隔离仓库验收，不是生产发布、完整 Runner 或全仓回归的证明。"
      />

      <div class="evidence-layout">
        <div class="evidence-list">
          {evidenceItems.map((item) => (
            <article class="evidence-item">
              <span class="evidence-date">{item.date}</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.detail}</p>
              </div>
              <span class="evidence-scope">{item.scope}</span>
            </article>
          ))}
        </div>

        <aside class="evidence-aside" aria-label="验证说明">
          <div class="verification-card">
            <h3>README 记录的测试数字</h3>
            <div class="verification-grid">
              {verificationNumbers.map((number) => (
                <div>
                  <strong>{number.value}</strong>
                  <span>{number.label}</span>
                </div>
              ))}
            </div>
          </div>
          <div class="caveat">
            <strong>不要把这些记录当作生产承诺</strong>
            完整 Runner、生产发布、所有 Provider 真实账号、全仓回归与其他平台仍未验收。
            执行成功、HTTP 就绪或状态检查都不能替代最终结果核对。
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section id="boundaries" class="section">
    <div class="container">
      <SectionHeading
        kicker="Boundaries / 边界"
        title="没有实现的能力，明确留在这里。"
        description="单用户、单服务组、显式继续和显式交付是当前设计的一部分。下面不是待办清单，而是使用前必须知道的范围。"
      />

      <div class="boundary-grid">
        {boundaries.map((boundary) => (
          <article class="boundary-card">
            <div class="boundary-top">
              <h3>{boundary.title}</h3>
              <span class="status-pill" data-status={boundary.status}>{boundary.status}</span>
            </div>
            <p>{boundary.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="placeholders" class="section">
    <div class="container">
      <SectionHeading
        kicker="Blank slots / 待补充"
        title="没有的东西，留出空白位置。"
        description="以下内容仓库里没有可引用的真实素材。页面保留位置，但不填占位文案、虚构数字或假徽章。"
      />

      <div class="placeholder-grid">
        {placeholders.map((item) => <PlaceholderCard {item} />)}
      </div>
    </div>
  </section>

  <section id="start" class="section">
    <div class="container">
      <div class="start">
        <div class="start-copy">
          <p class="eyebrow"><span class="eyebrow-rule" aria-hidden="true"></span>Run it locally</p>
          <h2>启动本机 v4 工作台。</h2>
          <p>
            这是自托管应用，不是托管服务。按 README 的 v4 步骤准备独立 PostgreSQL、
            迁移、账号与存储绑定，再由服务组启动统一 Web 入口。
          </p>
          <div class="start-actions">
            <a class="button button-primary" href={appUrl}>{appLabel}<span aria-hidden="true">↗</span></a>
            <a class="button button-ghost" href={agentWorkspaceUrl}>打开 Agent 会话<span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <div class="start-code">
          <div class="code-step">
            <div class="code-step-label"><span>01 / 初始化</span><span>repo root</span></div>
            <pre><code>pnpm install --frozen-lockfile
pnpm setup:local</code></pre>
          </div>
          <div class="code-step">
            <div class="code-step-label"><span>02 / 数据库与账号</span><span>fresh v4 database</span></div>
            <pre><code>pnpm db:up
pnpm db:migrate
pnpm bootstrap</code></pre>
          </div>
          <div class="code-step">
            <div class="code-step-label"><span>03 / 构建与启动</span><span>new empty install only</span></div>
            <pre><code>pnpm build:v4
pnpm storage bind --new --stopped --target-config .local/blob-target.json
pnpm services:start</code></pre>
          </div>
          <p class="code-note">
            仅适用于全新 v4 空库。已有数据不要执行 <code>storage bind --new</code>；
            默认入口为 <code>http://127.0.0.1:3224/pm</code>。完整前置条件、停写维护和恢复流程见仓库 README 与部署手册。
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="final-cta">
    <div class="container">
      <p class="eyebrow"><span class="eyebrow-rule" aria-hidden="true"></span>Start with the real thing</p>
      <h2>先看边界，再用真实数据验证。</h2>
      <p>
        营销页只描述仓库里已有的能力。真正启动后，请用自己的工作区、Provider 和项目目录检查结果，
        不要把界面状态、动画或成功派发当作完成。
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href={appUrl}>{appLabel}<span aria-hidden="true">↗</span></a>
        <a class="button button-ghost" href="#boundaries">阅读边界<span aria-hidden="true">↓</span></a>
      </div>
      <p class="entry-note">{appNote}</p>
    </div>
  </section>
</V4Layout>
